#!/bin/sh

# TimeControl 上网时间控制 - NFT/FW4优化版本
# Copyright 2024 sirpdboy

NAME="timecontrol"
CONFIG_FILE="/etc/config/$NAME"
LOG_FILE="/var/log/$NAME.log"
PID_FILE="/var/run/$NAME.pid"
DEBUG=1

# 日志函数
echolog() {
    local d="$(date "+%Y-%m-%d %H:%M:%S")"
    echo -e "$d: $*" >>$LOG_FILE
    [ "$DEBUG" -eq 1 ] && echo -e "$d: $*"
}

# UCI配置读取
config_n_get() {
    local ret=$(uci -q get "${NAME}.${1}.${2}" 2>/dev/null)
    echo "${ret:=$3}"
}

config_t_get() {
    local index=${4:-0}
    local ret=$(uci -q get "${NAME}.@${1}[${index}].${2}" 2>/dev/null)
    echo "${ret:=${3}}"
}

# 检查时间条件
check_time_condition() {
    local id=$1
    local time_valid=0
    local week_valid=0
    
    local start_time=$(config_t_get device timestart "00:00" $id)
    local end_time=$(config_t_get device timeend "23:59" $id)
    local wweek=$(config_t_get device week "0" $id)
    local current_time=$(date +%H:%M)
    local current_weekday=$(date +%u)

    # 转换时间为分钟数进行比较
    current_minutes=$((10#$(echo $current_time | cut -d: -f1) * 60 + 10#$(echo $current_time | cut -d: -f2)))
    start_minutes=$((10#$(echo $start_time | cut -d: -f1) * 60 + 10#$(echo $start_time | cut -d: -f2)))
    end_minutes=$((10#$(echo $end_time | cut -d: -f1) * 60 + 10#$(echo $end_time | cut -d: -f2)))

    # 全天候规则
    if [ "$start_time" = "00:00" -a "$end_time" = "23:59" ]; then
        time_valid=1
    else
        # 检查时间范围
        if [ $start_minutes -lt $end_minutes ]; then
            # 正常时间范围
            if [ $current_minutes -ge $start_minutes -a $current_minutes -le $end_minutes ]; then
                time_valid=1
            fi
        elif [ $start_minutes -gt $end_minutes ]; then
            # 跨天时间范围
            if [ $current_minutes -ge $start_minutes -o $current_minutes -le $end_minutes ]; then
                time_valid=1
            fi
        else
            time_valid=1
        fi
    fi

    # 检查星期几
    if [ "$wweek" = "0" ]; then
        week_valid=1
    else
        # 检查当前星期是否在允许的星期列表中
        echo "$wweek" | tr ',' '\n' | while read day; do
            if [ "$current_weekday" = "$day" ]; then
                week_valid=1
                break
            fi
        done
    fi

    [ "$DEBUG" -eq 1 ] && echolog "检查设备ID $id: 时间有效=$time_valid, 星期有效=$week_valid, 开始=$start_time, 结束=$end_time, 星期=$wweek"

    [ "$time_valid" -eq 1 ] && [ "$week_valid" -eq 1 ] && return 0 || return 1
}

# 获取目标类型和NFT表达式
get_target_nft_expr() {
    local target=$1
    
    # IPv4地址
    if echo "$target" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
        echo "ip saddr $target"
    # IPv4范围
    elif echo "$target" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}-([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
        echo "ip saddr $target"
    # IPv4子网
    elif echo "$target" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}/[0-9]{1,2}$'; then
        echo "ip saddr $target"
    # IPv6地址
    elif echo "$target" | grep -qE '^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}$'; then
        echo "ip6 saddr $target"
    # IPv6子网
    elif echo "$target" | grep -qE '^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}/[0-9]{1,3}$'; then
        echo "ip6 saddr $target"
    # MAC地址
    elif echo "$target" | grep -qE '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$'; then
        echo "ether saddr $target"
    else
        return 1
    fi
}

# 获取地址族
get_target_family() {
    local target=$1
    
    # IPv4地址
    if echo "$target" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}(-[0-9]{1,3}\.){3}[0-9]{1,3}|/([0-9]{1,2})?$'; then
        echo "ip"
    # IPv6地址
    elif echo "$target" | grep -qE '^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}(/[0-9]{1,3})?$'; then
        echo "ip6"
    # MAC地址
    elif echo "$target" | grep -qE '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$'; then
        echo "arp"
    else
        return 1
    fi
}

# 检查NFT链是否存在
nft_chain_exists() {
    local family=$1
    local chain=$2
    nft list chain $family fw4 $chain >/dev/null 2>&1
}

# 创建NFT链
create_nft_chain() {
    local family=$1
    local chain=$2
    local hook=$3
    local policy=$4
    
    if ! nft_chain_exists "$family" "$chain"; then
        nft add chain $family fw4 $chain "{ type filter hook $hook priority 0; policy $policy; }"
        echolog "创建NFT链: $family fw4 $chain"
        return 0
    fi
    return 1
}

# 添加NFT规则
add_nft_rule() {
    local target=$1
    local mode=$2
    local chain_type=$3
    local comment="$4"
    
    local target_expr=$(get_target_nft_expr "$target")
    [ $? -ne 0 ] && {
        echolog "错误: 无效的目标地址格式: $target"
        return 1
    }
    
    # 确定地址族
    local family=$(get_target_family "$target")
    [ $? -ne 0 ] && {
        echolog "错误: 无法确定目标地址族: $target"
        return 1
    }
    
    # 确定链类型
    local chain_name="time_control_forward"
    local hook="forward"
    local policy="accept"
    
    case "$chain_type" in
        "input")
            hook="input"
            chain_name="time_control_input"
            ;;
        "forward")
            hook="forward" 
            chain_name="time_control_forward"
            ;;
    esac
    
    # 创建链
    create_nft_chain "$family" "$chain_name" "$hook" "$policy"
    
    # 检查规则是否已存在
    if nft list chain $family fw4 $chain_name | grep -q "$target_expr"; then
        echolog "规则已存在: $target"
        return 0
    fi
    
    # 添加规则
    if [ "$mode" = "blacklist" ]; then
        nft insert rule $family fw4 $chain_name $target_expr counter drop
        echolog "NFT[黑名单]: 已禁止 $target 的网络访问 ($comment)"
    else
        nft insert rule $family fw4 $chain_name $target_expr counter accept
        echolog "NFT[白名单]: 已允许 $target 的网络访问 ($comment)"
    fi
    
    return 0
}

# 删除NFT规则
delete_nft_rule() {
    local target=$1
    local chain_type=$2
    
    local target_expr=$(get_target_nft_expr "$target")
    [ $? -ne 0 ] && return 1
    
    local family=$(get_target_family "$target")
    [ $? -ne 0 ] && return 1
    
    local chain_name="time_control_forward"
    case "$chain_type" in
        "input") chain_name="time_control_input" ;;
        "forward") chain_name="time_control_forward" ;;
    esac
    
    # 删除匹配的规则
    if nft_chain_exists "$family" "$chain_name"; then
        local rules_handles=$(nft -a list chain $family fw4 $chain_name | \
            grep -A5 "$target_expr" | grep "handle" | awk '{print $2}')
        
        for handle in $rules_handles; do
            nft delete rule $family fw4 $chain_name handle $handle 2>/dev/null
        done
        
        if [ -n "$rules_handles" ]; then
            echolog "已移除 $target 的NFT规则"
        fi
    fi
}

# 清理NFT规则
cleanup_nft() {
    for family in ip ip6 arp; do
        for chain in time_control_forward time_control_input; do
            if nft_chain_exists "$family" "$chain"; then
                nft delete chain $family fw4 $chain 2>/dev/null
                echolog "清理NFT链: $family fw4 $chain"
            fi
        done
    done
}

# 初始化NFT
init_nft() {
    local chain_type=$1
    
    local chain_name="time_control_forward"
    local hook="forward"
    
    case "$chain_type" in
        "input")
            chain_name="time_control_input"
            hook="input"
            ;;
        "forward")
            chain_name="time_control_forward" 
            hook="forward"
            ;;
    esac
    
    # 为所有地址族创建链
    for family in ip ip6 arp; do
        create_nft_chain "$family" "$chain_name" "$hook" "accept"
    done
}

# 应用设备规则
apply_device_rules() {
    local mode=$1
    local chain_type=$2
    
    # 获取所有设备
    local device_count=0
    if [ -f "$CONFIG_FILE" ]; then
        device_count=$(uci show $NAME 2>/dev/null | grep -c "=device" || echo "0")
    fi
    
    echolog "找到 $device_count 个设备配置"
    
    for i in $(seq 0 $((device_count-1)) 2>/dev/null); do
        local enable=$(config_t_get device enable "0" $i)
        local target=$(config_t_get device mac "" $i)
        local comment=$(config_t_get device comment "设备$i" $i)
        
        [ "$enable" != "1" ] && continue
        [ -z "$target" ] && {
            echolog "警告: 设备ID $i 没有配置目标地址"
            continue
        }
        
        if check_time_condition $i; then
            add_nft_rule "$target" "$mode" "$chain_type" "$comment"
        else
            delete_nft_rule "$target" "$chain_type"
        fi
    done
}

# 显示当前规则状态
show_nft_status() {
    echolog "当前NFT规则状态:"
    for family in ip ip6 arp; do
        for chain in time_control_forward time_control_input; do
            if nft_chain_exists "$family" "$chain"; then
                echolog "=== $family fw4 $chain ==="
                nft list chain $family fw4 $chain | while read line; do
                    if echo "$line" | grep -qE "drop|accept"; then
                        echolog "  $line"
                    fi
                done
            fi
        done
    done
}

# 主控制循环
main_loop() {
    echolog "TimeControl NFT服务启动"
    
    local mode=$(config_n_get timecontrol list_type "blacklist")
    local chain_type=$(config_n_get timecontrol chain "forward")
    
    # 初始化NFT
    init_nft "$chain_type"
    
    local loop_count=0
    while true; do
        loop_count=$((loop_count + 1))
        if [ $((loop_count % 30)) -eq 0 ]; then  # 每30分钟记录一次状态
            echolog "服务运行中，模式: $mode, 链类型: $chain_type, 循环: $loop_count"
            show_nft_status
        fi
        
        apply_device_rules "$mode" "$chain_type"
        sleep 60  # 每分钟检查一次
    done
}

# 停止服务
stop_service() {
    local pid=""
    if [ -f "$PID_FILE" ]; then
        pid=$(cat $PID_FILE 2>/dev/null)
    fi
    
    if [ -n "$pid" ] && kill -0 $pid 2>/dev/null; then
        kill $pid 2>/dev/null
        echolog "TimeControl 服务已停止 (PID: $pid)"
    else
        echolog "TimeControl 服务未运行"
    fi
    
    rm -f $PID_FILE 2>/dev/null
    
    # 清理NFT规则
    cleanup_nft
}

# 启动服务
start_service() {
    # 检查是否已运行
    if [ -f "$PID_FILE" ]; then
        local old_pid=$(cat $PID_FILE 2>/dev/null)
        if [ -n "$old_pid" ] && kill -0 $old_pid 2>/dev/null; then
            echolog "服务已在运行 (PID: $old_pid)，先停止"
            stop_service
            sleep 2
        fi
    fi
    
    # 启动服务
    main_loop &
    local pid=$!
    echo $pid > $PID_FILE
    echolog "TimeControl NFT服务启动，PID: $pid"
}

# 服务状态
service_status() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat $PID_FILE)
        if kill -0 $pid 2>/dev/null; then
            echo "运行中 (PID: $pid)"
            show_nft_status
            return 0
        else
            echo "PID文件存在但进程未运行"
            return 1
        fi
    else
        echo "未运行"
        return 1
    fi
}

# 重新加载配置
reload_config() {
    echolog "重新加载配置"
    apply_device_rules "$(config_n_get timecontrol list_type "blacklist")" "$(config_n_get timecontrol chain "forward")"
}

# 信号处理
trap 'stop_service; exit 0' TERM INT

case "${1:-start}" in
    "start")
        start_service
        ;;
    "stop")
        stop_service
        ;;
    "restart")
        stop_service
        sleep 2
        start_service
        ;;
    "status")
        service_status
        ;;
    "reload")
        reload_config
        ;;
    "debug")
        DEBUG=1
        start_service
        ;;
    *)
        echo "用法: $0 {start|stop|restart|status|reload|debug}"
        echo "  start   启动服务"
        echo "  stop    停止服务"
        echo "  restart 重启服务"
        echo "  status  服务状态"
        echo "  reload  重新加载配置"
        echo "  debug   调试模式启动"
        exit 1
        ;;
esac