{
	"luci-app-timecontrol": {
		"description": "Grant UCI Internet time control for luci-app-timecontrol",
		"read": {
			"file": {
				"/etc/init.d/timecontrol": [ "exec" ],
				"/usr/bin/timecontrol": [ "exec" ],
				"/usr/bin/timecontrolctrl": [ "exec" ],
				"/usr/libexec/timecontrol-call": [ "exec" ]
				"/bin/pidof": [ "exec" ]
			},
			"ubus": {
				"control": [ "list" ]
			},
			"uci": [ "timecontrol" ]
		},
		"write": {
			"file": {
				"/tmp/*": [ "write" ],
				"/var/log/*": [ "write" ]
			},
			"uci": [ "timecontrol" ]
		}
	}
}
