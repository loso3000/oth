# 支持IPv6的时间控制插件

crrun=$1
crid=$2
NAME=timecontrol
CONFIG_FILE="/etc/config/$NAME"
LOG_FILE="/var/log/$NAME.log"
IDLIST="/var/$NAME.idlist"
TMPID="/var/$NAME.tmpid"
CHAIN="TIME_CONTROL"

DEBUG=1

# 检测防火墙后端
if command -v nft >/dev/null && [ -x /sbin/fw4 ]; then
    nftables_ver="true"
fi
if command -v iptables >/dev/null; then
    iptables_ver="true"
fi

# 日志函数
echolog() {
    local d="$(date "+%Y-%m-%d %H:%M:%S")"
    echo -e "$d: $*" >>$LOG_FILE
    [ "$DEBUG" -eq 1 ] && echo -e "$d: $*"
}

# UCI配置读取函数
config_get_type() {
    local ret=$(uci -q get "${NAME}.${1}" 2>/dev/null)
    echo "${ret:=$2}"
}

config_n_get() {
    local ret=$(uci -q get "${NAME}.${1}.${2}" 2>/dev/null)
    echo "${ret:=$3}"
}

config_t_get() {
    local index=${4:-0}
    local ret=$(uci -q get "${NAME}.@${1}[${index}].${2}" 2>/dev/null)
    echo "${ret:=${3}}"
}

# 获取目标类型和地址族
get_target_info() {
    local target=$1
    
    # IPv4地址
    if echo "$target" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}(/[0-9]{1,2})?$'; then
        echo "ipv4 ip $target"
    # IPv6地址
    elif echo "$target" | grep -qE '^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}(/[0-9]{1,3})?$'; then
        echo "ipv6 ip6 $target"
    # MAC地址
    elif echo "$target" | grep -qE '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$'; then
        echo "mac ether $target"
    else
        return 1
    fi
}

# 检查时间条件
check_time_condition() {
    local id=$1
    local checkid='0'
    local start_time=$(config_t_get device timestart "00:00" $id)
    local end_time=$(config_t_get device timeend "23:59" $id)
    local wweek=$(config_t_get device week "0" $id)
    local current_time=$(date +%H:%M)
    local current_weekday=$(date +%u)

    # 全天候规则
    if [ "$start_time" = "00:00" ] && [ "$end_time" = "23:59" ]; then
        time_valid=1
    else
        # 检查时间范围
        if [ "$start_time" != "$end_time" ]; then
            if [[ "$start_time" < "$end_time" ]]; then
                [[ "$current_time" > "$start_time" ]] && [[ "$current_time" < "$end_time" ]] && time_valid=1 || time_valid=0
            else
                [[ "$current_time" < "$start_time" ]] && [[ "$current_time" > "$end_time" ]] && time_valid=0 || time_valid=1
            fi
        else
            time_valid=1
        fi
    fi

    # 检查星期几
    [ "$wweek" = "0" ] && week_valid=1
    for ww in $(echo "$wweek" | sed 's/,/ /g'); do
        if [ "$current_weekday" = "$ww" ]; then
            week_valid=1
            break
        fi
    done

    [ "$time_valid" -eq 1 ] && [ "$week_valid" -eq 1 ] && return 0 || return 1
}

# 添加时间控制规则
add_time_rule() {
    local id=$1
    local target=$(config_t_get device mac "" $id)
    local enable=$(config_t_get device enable "0" $id)
    local control_mode=$(config_get_type $NAME control_mode "blacklist")
    
    [ "$enable" != "1" ] && return 0
    
    local target_info=$(get_target_info "$target")
    [ $? -ne 0 ] && return 1
    
    read -r target_type addr_type target_val <<< "$target_info"
    
    # nftables处理
    if [ -n "$nftables_ver" ]; then
        ! nft list chain inet fw4 time_control >/dev/null 2>&1 && \
            nft add chain inet fw4 time_control { type filter hook forward priority 0 \; }
        
        if [ "$control_mode" = "blacklist" ]; then
            nft add rule inet fw4 time_control $addr_type saddr $target_val counter drop
            echolog "nftables[黑名单]: 已禁止$target_type $target_val 的网络访问"
        else
            nft add rule inet fw4 time_control $addr_type saddr $target_val counter accept
            echolog "nftables[白名单]: 已允许$target_type $target_val 的网络访问"
        fi
    fi
    
    # iptables处理
    if [ -n "$iptables_ver" ]; then
        case "$target_type" in
            ipv4)
                ! iptables -nL TIME_CONTROL >/dev/null 2>&1 && {
                    iptables -N TIME_CONTROL
                    iptables -I FORWARD -j TIME_CONTROL
                }
                if [ "$control_mode" = "blacklist" ]; then
                    iptables -A TIME_CONTROL -s $target_val -j DROP
                    echolog "iptables[黑名单]: 已禁止IPv4 $target_val 的网络访问"
                else
                    iptables -A TIME_CONTROL -s $target_val -j ACCEPT
                    echolog "iptables[白名单]: 已允许IPv4 $target_val 的网络访问"
                fi
                ;;
            ipv6)
                ! ip6tables -nL TIME_CONTROL6 >/dev/null 2>&1 && {
                    ip6tables -N TIME_CONTROL6
                    ip6tables -I FORWARD -j TIME_CONTROL6
                }
                if [ "$control_mode" = "blacklist" ]; then
                    ip6tables -A TIME_CONTROL6 -s $target_val -j DROP
                    echolog "iptables[黑名单]: 已禁止IPv6 $target_val 的网络访问"
                else
                    ip6tables -A TIME_CONTROL6 -s $target_val -j ACCEPT
                    echolog "iptables[白名单]: 已允许IPv6 $target_val 的网络访问"
                fi
                ;;
            mac)
                ! iptables -nL TIME_CONTROL >/dev/null 2>&1 && {
                    iptables -N TIME_CONTROL
                    iptables -I FORWARD -j TIME_CONTROL
                }
                if [ "$control_mode" = "blacklist" ]; then
                    iptables -A TIME_CONTROL -m mac --mac-source $target_val -j DROP
                    echolog "iptables[黑名单]: 已禁止MAC $target_val 的网络访问"
                else
                    iptables -A TIME_CONTROL -m mac --mac-source $target_val -j ACCEPT
                    echolog "iptables[白名单]: 已允许MAC $target_val 的网络访问"
                fi
                ;;
        esac
    fi
}

# 删除时间控制规则
del_time_rule() {
    local id=$1
    local target=$(config_t_get device mac "" $id)
    
    [ -z "$target" ] && return 0
    
    local target_info=$(get_target_info "$target")
    [ $? -ne 0 ] && return 1
    
    read -r target_type addr_type target_val <<< "$target_info"
    
    # nftables处理
    if [ -n "$nftables_ver" ]; then
        nft delete rule inet fw4 time_control handle $(nft -a list chain inet fw4 time_control | grep "$addr_type saddr $target_val" | awk '{print $NF}') 2>/dev/null
    fi
    
    # iptables处理
    if [ -n "$iptables_ver" ]; then
        case "$target_type" in
            ipv4)
                iptables -D TIME_CONTROL -s $target_val -j DROP 2>/dev/null
                iptables -D TIME_CONTROL -s $target_val -j ACCEPT 2>/dev/null
                ;;
            ipv6)
                ip6tables -D TIME_CONTROL6 -s $target_val -j DROP 2>/dev/null
                ip6tables -D TIME_CONTROL6 -s $target_val -j ACCEPT 2>/dev/null
                ;;
            mac)
                iptables -D TIME_CONTROL -m mac --mac-source $target_val -j DROP 2>/dev/null
                iptables -D TIME_CONTROL -m mac --mac-source $target_val -j ACCEPT 2>/dev/null
                ;;
        esac
    fi
    
    echolog "已移除 $target_val 的访问控制规则"
}

# 停止所有规则
stop_timecontrol() {
    # nftables清理
    if [ -n "$nftables_ver" ]; then
        nft delete chain inet fw4 time_control 2>/dev/null
    fi
    
    # iptables清理
    if [ -n "$iptables_ver" ]; then
        iptables -F TIME_CONTROL 2>/dev/null
        iptables -X TIME_CONTROL 2>/dev/null
        ip6tables -F TIME_CONTROL6 2>/dev/null
        ip6tables -X TIME_CONTROL6 2>/dev/null
    fi
    
    echolog "所有时间控制规则已清除"
}

# 主启动函数
start_timecontrol() {
    
    # 初始化防火墙规则
    if [ -n "$nftables_ver" ]; then
        ! nft list chain inet fw4 time_control >/dev/null 2>&1 && \
            nft add chain inet fw4 time_control { type filter hook forward priority 0 \; }
    fi
    
    if [ -n "$iptables_ver" ]; then
        ! iptables -nL TIME_CONTROL >/dev/null 2>&1 && {
            iptables -N TIME_CONTROL
            iptables -I FORWARD -j TIME_CONTROL
        }
        ! ip6tables -nL TIME_CONTROL6 >/dev/null 2>&1 && {
            ip6tables -N TIME_CONTROL6
            ip6tables -I FORWARD -j TIME_CONTROL6
        }
    fi

}

# 主程序
case "$crrun" in
    "stop")
        stop_timecontrol
        echo "" > "$IDLIST"
        ;;
    "start")
        idlist=$(uci show $NAME | grep "enable='1'" | grep "device" | grep -oE '\[.*?\]' | grep -o '[0-9]' | sed -e 's/^/!/g' -e 's/$/!/g' > "$IDLIST"; cat "$IDLIST" | sed -e 's/!//g')
        start_timecontrol
        for id in $(echo "$idlist" | sed -e 's/!//g'); do
            if check_time_condition "$list"; then
                add_time_rule "$id"
                echo "!${id}!" >> "$IDLIST"
            else
                    del_time_rule "$id"
                    sed -i "/!$id!/d" "$IDLIST" >/dev/null 2>&1
            fi
        done
        echolog "时间控制插件已启动"
        ;;
    "add")
        for id in $(echo "$crid" | sed -e 's/!//g' | sed 's/,/ /g'); do
            if check_time_condition "$id"; then
                add_time_rule "$id"
                echo "!${id}!" >> "$IDLIST"
            else
                del_time_rule "$id"
                sed -i "/!$id!/d" "$IDLIST" >/dev/null 2>&1
            fi
        done
        ;;
    "del")
        for id in $(echo "$crid" | sed -e 's/!//g' | sed 's/,/ /g'); do
            del_time_rule "$id"
            sed -i "/!$id!/d" "$IDLIST" >/dev/null 2>&1
        done
        ;;
    *)
        echolog "无效命令: $crrun"
        echo "用法: $0 {start|stop|add ID|del ID}"
        exit 1
        ;;
esac

