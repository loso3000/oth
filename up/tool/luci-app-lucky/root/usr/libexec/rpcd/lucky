#!/usr/bin/lua
module("lucky", package.seeall)

local util = require "luci.util"
local json = require "luci.jsonc"

function get_ConfInfo()
    local result = util.exec("/usr/bin/lucky -baseConfInfo 2>/dev/null")
    if result and result ~= "" then
        local ok, data = pcall(json.parse, result)
        if ok and data then
            return { ConfInfo = data }
        end
    end
    return { ConfInfo = {} }
end

function set_ConfInfo(params)
    local key = params.key
    local value = params.value
    local configPath = params.configPath or "/etc/lucky"
    
    if not key then
        return { status = 255, error = "Missing key parameter" }
    end
    
    local cmd
    if value and value ~= "" then
        cmd = string.format("/usr/bin/lucky -setconf -key '%s' -value '%s' -cd '%s'", 
            key, value, configPath)
    else
        cmd = string.format("/usr/bin/lucky -setconf -key '%s' -cd '%s'", 
            key, configPath)
    end
    
    local exit_code = os.execute(cmd .. " >/dev/null 2>&1")
    return { status = exit_code }
end
