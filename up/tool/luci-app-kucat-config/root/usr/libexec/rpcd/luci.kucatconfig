#!/bin/sh

. /lib/functions.sh
. /usr/share/libubox/jshn.sh

readonly bg_path="/www/luci-static/resources/background"
readonly bg_pathd="/www/luci-static/kucat/background"
readonly tmp_path="/tmp/kucat_login_bg.tmp"
readonly tmp_pathd='/tmp/kucat_desktop_bg.tmp'

# 创建目录函数
create_dirs() {
    mkdir -p "$bg_path" "$bg_pathd"
    chmod 755 "$bg_path" "$bg_pathd"
}

# 安全检查函数
check_filename() {
    local filename="$1"
    [ -z "$filename" ] && return 1
    # 防止路径遍历
    if echo "$filename" | grep -q '\.\.' || echo "$filename" | grep -q '/'; then
        return 1
    fi
    # 检查文件扩展名
    local extension=$(echo "$filename" | awk -F. '{print tolower($NF)}')
    case "$extension" in
        jpg|jpeg|png|gif|webp|mp4|webm)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# 获取可用空间（正确的方法）
get_avail_space() {
    # 获取根分区或/www分区的可用空间（以KB为单位）
    local avail_kb
    if [ -d "/www" ]; then
        # 如果有/www分区，使用它的可用空间
        avail_kb=$(df -k "/www" 2>/dev/null | awk 'NR==2 {print $4}')
    else
        # 否则使用根分区的可用空间
        avail_kb=$(df -k "/" 2>/dev/null | awk 'NR==2 {print $4}')
    fi
    
    # 如果获取失败，使用默认值
    [ -z "$avail_kb" ] && avail_kb=0
    
    # 转换为MB
    local avail_mb=$((avail_kb / 1024))
    echo "$avail_mb"
}

case "$1" in
"list")
    json_init
    json_add_array "methods"
    
    # 登录背景方法
    json_add_object
    json_add_string "method" "avail"
    json_add_array "params"
    json_close_array
    json_add_string "description" "Get available disk space for login background"
    json_close_object
    
    json_add_object
    json_add_string "method" "remove"
    json_add_array "params"
    json_add_string "filename" "string"
    json_close_array
    json_add_string "description" "Remove login background file"
    json_close_object
    
    json_add_object
    json_add_string "method" "rename"
    json_add_array "params"
    json_add_string "newname" "string"
    json_close_array
    json_add_string "description" "Rename/Move uploaded login background file"
    json_close_object
    
    # 桌面背景方法
    json_add_object
    json_add_string "method" "availd"
    json_add_array "params"
    json_close_array
    json_add_string "description" "Get available disk space for desktop background"
    json_close_object
    
    json_add_object
    json_add_string "method" "removed"
    json_add_array "params"
    json_add_string "filename" "string"
    json_close_array
    json_add_string "description" "Remove desktop background file"
    json_close_object
    
    json_add_object
    json_add_string "method" "renamed"
    json_add_array "params"
    json_add_string "newname" "string"
    json_close_array
    json_add_string "description" "Rename/Move uploaded desktop background file"
    json_close_object
    
    json_close_array
    json_dump
    ;;
"call")
    # 创建目录
    create_dirs
    
    case "$2" in
    "avail")
        json_init
        json_add_int "avail" "$(get_avail_space)"
        json_dump
        ;;
    "remove")
        read -r input
        json_load "$input"
        json_get_var filename "filename"
        json_cleanup

        if ! check_filename "$filename"; then
            echo '{ "result": 255 }'
            exit 0
        fi

        if rm -f "$bg_path/$filename"; then
            echo '{ "result": 0 }'
        else
            echo '{ "result": 1 }'
        fi
        ;;
    "rename")
        read -r input
        json_load "$input"
        json_get_var newname "newname"
        json_cleanup

        if ! check_filename "$newname"; then
            echo '{ "result": 255 }'
            exit 0
        fi

        # 确保临时文件存在
        if [ ! -f "$tmp_path" ]; then
            echo '{ "result": 1, "error": "Temporary file not found" }'
            exit 0
        fi

        if mv "$tmp_path" "$bg_path/$newname" 2>/dev/null; then
            chmod 0644 "$bg_path/$newname"
            echo '{ "result": 0 }'
        else
            echo '{ "result": 1, "error": "Failed to move file" }'
        fi
        ;;
    "availd")
        json_init
        json_add_int "avail" "$(get_avail_space)"
        json_dump
        ;;
    "removed")
        read -r input
        json_load "$input"
        json_get_var filename "filename"
        json_cleanup

        if ! check_filename "$filename"; then
            echo '{ "result": 255 }'
            exit 0
        fi

        if rm -f "$bg_pathd/$filename"; then
            echo '{ "result": 0 }'
        else
            echo '{ "result": 1 }'
        fi
        ;;
    "renamed")
        read -r input
        json_load "$input"
        json_get_var newname "newname"
        json_cleanup

        if ! check_filename "$newname"; then
            echo '{ "result": 255 }'
            exit 0
        fi

        # 确保临时文件存在
        if [ ! -f "$tmp_pathd" ]; then
            echo '{ "result": 1, "error": "Temporary file not found" }'
            exit 0
        fi

        if mv "$tmp_pathd" "$bg_pathd/$newname" 2>/dev/null; then
            chmod 0644 "$bg_pathd/$newname"
            echo '{ "result": 0 }'
        else
            echo '{ "result": 1, "error": "Failed to move file" }'
        fi
        ;;
    *)
        echo '{ "result": 1, "error": "Unknown method" }'
        ;;
    esac
    ;;
*)
    echo '{ "result": 1, "error": "Invalid command" }'
    ;;
esac