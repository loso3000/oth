
{
     "luci-app-netwizard": {
		"description": "Grant UCI access for luci-app-netwizard",
	"read": {
            "ubus": {

                        "file": ["exec", "list", "stat", "read"],
                        "uci": [ "*" ],
                        "netwizard": ["*"]
            }
	},
	"write": {
            "ubus": {
                "netwizard": ["*"],
                "file": ["write"],
                "uci": ["*"]
      }
    }
  }
}