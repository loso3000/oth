{
    "luci-app-eqosplus": {
        "description": "Grant UCI access for luci-app-eqosplus",
        "read": {
            "file": {
        			"/etc/init.d/eqosplus": [ "exec" ],
        			"/usr/bin/eqosplus": [ "exec" ],
        			"/usr/bin/eqosplusctrl": [ "exec" ],
				"/bin/pidof": [ "exec" ],
        			"/var/*": [ "read" ]
			},
			"uci": [ "eqosplus" ]
		},
	"write": {
			"file": {
				"/tmp/*": [ "write" ]
			},
			"uci": [ "eqosplus" ]
		}
	}
}
